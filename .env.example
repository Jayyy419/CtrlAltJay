# Admin Passcode — set ONE of these (the app reads these exact names).
# Prefer ADMIN_PASSCODE_HASH in production; generate it with:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('your-passcode'))"
# ADMIN_PASSWORD is accepted too, as a legacy alias for ADMIN_PASSCODE — kept
# for deployments already configured with that name. New setups should use
# ADMIN_PASSCODE_HASH or ADMIN_PASSCODE instead.
ADMIN_PASSCODE_HASH=
ADMIN_PASSCODE=change_me

# Flask Configuration
SECRET_KEY=your-secret-key-here
# Set to 1 only for local HTTP development — enables the Werkzeug debugger
# and disables the Secure cookie flag. Never set this in production.
FLASK_DEBUG=0

# Email Configuration (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_USE_TLS=true
MAIL_USE_SSL=false

# MAIL_PASSWORD: set directly, OR point at a stored secret. Resolution order
# is SSM Parameter Store, then Secrets Manager, then this plain value.
# SSM SecureString is preferred in production — it is free, where Secrets
# Manager bills $0.40/secret/month.
MAIL_PASSWORD=your-app-password
MAIL_PASSWORD_SECRET_ID=

# ── SSM Parameter Store (production) ──────────────────────────────────────
# Each names an SSM SecureString parameter to read that secret from at
# startup, instead of holding it in plaintext config. The execution role
# needs ssm:GetParameter plus kms:Decrypt for each. Leave blank locally.
MAIL_PASSWORD_SSM_PARAM=
SECRET_KEY_SSM_PARAM=
ADMIN_PASSCODE_SSM_PARAM=
ADMIN_PASSCODE_HASH_SSM_PARAM=
ANTHROPIC_API_KEY_SSM_PARAM=

# S3 Backup (required to use /api/admin/backup — no default bucket)
BACKUP_S3_BUCKET=your-backup-bucket-name

# Uploads: when set, admin image uploads go to s3://<bucket>/static/uploads/
# instead of the local filesystem. Required on Lambda (read-only disk);
# leave blank locally to keep using static/uploads/ on disk.
STATIC_S3_BUCKET=

# AWS region for DynamoDB/S3 (defaults to ap-southeast-1 if unset)
AWS_REGION=ap-southeast-1
